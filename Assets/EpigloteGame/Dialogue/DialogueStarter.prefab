  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    lines:
    - name: Leahunter
      sprite: {fileID: 21300000, guid: ab744da194e331241ae0f5676accba42, type: 3}
      sentence: "Muito bem! Voc\xEA conseguiu!"
    - name: Leahunter
      sprite: {fileID: 21300000, guid: ab744da194e331241ae0f5676accba42, type: 3}
      sentence: "Quando quiser, pode voltar a responder o question\xE1rio."
    - name: Leohunter
      sprite: {fileID: 21300000, guid: c96fc8a117e7b9e4d814f9ea79b58b5c, type: 3}
      sentence: Ou podemos praticar mais um pouco...
    - name: Leohunter
      sprite: {fileID: 21300000, guid: c96fc8a117e7b9e4d814f9ea79b58b5c, type: 3}
      sentence: "E a\xED? O que vai ser?"
